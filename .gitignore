# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, you probably want to ignore it.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're building something that shouldn't be locked, un-comment the next line:
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be in version control.
#   However, if you're building a library, un-comment the next line:
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be in version control.
#pdm.lock
#   pdm local configuration
.pdm-python.path
.pdm-build/

